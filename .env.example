# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=meta-reports.local,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://meta-reports.local

# AES-256-GCM key: URL-safe base64 encoding of exactly 32 random bytes.
DATA_ENCRYPTION_KEY=replace-with-generated-base64-key

# First local operator account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ultex.local
ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL
POSTGRES_DB=meta_reports
POSTGRES_USER=meta_reports
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Background jobs
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# Meta API version can be upgraded without changing application code.
META_GRAPH_API_VERSION=v25.0
META_GRAPH_API_BASE=https://graph.facebook.com

# Local file retention
BACKUP_DIR=/app/backups

